# Copy to .env and fill in for your Ubuntu host.
# Find your interface + subnet with: ip -o -4 addr show

# --- Needed only for the 'buggy' (macvlan) profile ---
PARENT_IFACE=eth0
SUBNET=192.168.1.0/24
GATEWAY=192.168.1.1
SERVER_IP=192.168.1.50
CLIENT_IP=192.168.1.51

# --- Needed only for the 'fixed' (host network) profile ---
# Any free TCP port on the host is fine; no IP needed since containers
# share the host's own network stack directly.
FIXED_PORT=5000
